{
  "version": 2,
  "rewrites": [
    { "source": "/form", "destination": "/sample/landing.html" },
    { "source": "/form/", "destination": "/sample/landing.html" }
  ],
  "headers": [
    {
      "source": "/sample/landing.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
